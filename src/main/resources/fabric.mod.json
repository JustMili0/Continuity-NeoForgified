{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "contact": {
    "homepage": "https://modrinth.com/mod/continuity",
    "issues": "https://github.com/PepperCode1/Continuity/issues",
    "sources": "https://github.com/PepperCode1/Continuity"
  },
  "license": "${mod_license}",
  "environment": "client",
  "accessWidener": "${mod_id}.accesswidener",
  "entrypoints": {
    "client": [
      "me.pepperbell.continuity.client.ContinuityClient"
    ],
    "modmenu": [
      "me.pepperbell.continuity.client.config.ModMenuApiImpl"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_constraint}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/7rnTYXu"
      }
    }
  }
}